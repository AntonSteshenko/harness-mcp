# Host port for the local MinIO S3 API. Override if 9000 is already in use.
MINIO_API_PORT=9000

# Host port for the local MinIO web console. Override if 9001 is already in use.
MINIO_CONSOLE_PORT=9001

# Credentials the MCP server (specs/002-s3-mcp-server) uses to authenticate against
# the local MinIO S3 API. Must match the fixed values committed in docker-compose.yml.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# The single, pre-configured bucket the MCP server (specs/002-s3-mcp-server) presents
# to MCP clients as its filesystem root (FR-013). Created automatically if missing.
MCP_STORAGE_BUCKET=mcp-storage
