# Host port for the local MinIO S3 API. Override if 9000 is already in use.
MINIO_API_PORT=9000

# Host port for the local MinIO web console. Override if 9001 is already in use.
MINIO_CONSOLE_PORT=9001

# Credentials for the local MinIO S3 API. Must match the fixed values committed
# in docker-compose.yml.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# App-level storage connection settings (which bucket, which S3-compatible
# provider, credentials, etc.) live in frontend/.env.example instead of here —
# Next.js only loads env files from its own project root (frontend/), and as
# of spec 007-s3-storage-config the app can connect to any S3-compatible
# backend, not only this local MinIO instance. See frontend/.env.example.
